<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.nitro.ae" ExtensionBundleVersion="1.0.0" ExtensionBundleName="Nitro" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.nitro.ae.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[16.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.nitro.ae.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/nitro.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Nitro</Menu>
          <Geometry>
            <Size>
              <Height>700</Height>
              <Width>400</Width>
            </Size>
            <MinSize>
              <Height>320</Height>
              <Width>260</Width>
            </MinSize>
            <MaxSize>
              <Height>2400</Height>
              <Width>1400</Width>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./client/img/icon-23.png</Icon>
            <Icon Type="RollOver">./client/img/icon-23.png</Icon>
            <Icon Type="DarkNormal">./client/img/icon-23.png</Icon>
            <Icon Type="DarkRollOver">./client/img/icon-23.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
